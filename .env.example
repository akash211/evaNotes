# === evaNotes Configuration ===

# === Server ===
HOST=0.0.0.0
PORT=8080
RUST_LOG=info

# === Database ===
# SQLite database stored at: $EVA_DATA_DIR/evanotes.db
# Docker default: /data | Local default: ~/.evanotes
EVA_DATA_DIR=/data

# === Authentication ===
# Authorized administrator email (or set via Web UI on first launch)
ADMIN_EMAIL=

# HMAC secret for session signing (auto-generated if empty)
SESSION_SECRET=

# Google OAuth 2.0 Client ID (for Google Sign-In)
GOOGLE_CLIENT_ID=

# === Security ===
# Set to true when running behind HTTPS reverse proxy or domain
SECURE_COOKIES=false

# Set to true to enforce automatic HTTPS redirect for all non-local requests
ENFORCE_HTTPS=false

# === SMTP (Optional, for OTP email delivery) ===
# If empty, OTP codes are logged to stdout/Docker logs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
