# === evaNotes Configuration ===

# === Server ===
HOST=0.0.0.0
PORT=8080
RUST_LOG=info

# === Database ===
# SQLite database stored at: $EVA_DATA_DIR/evanotes.db
# Docker default: /data | Local default: ~/.evanotes
EVA_DATA_DIR=/data

# === Authentication ===
# Authorized administrator email (empty = any email may sign in)
ADMIN_EMAIL=

# HMAC secret for session signing (auto-generated if empty — sessions reset on restart)
SESSION_SECRET=

# Google OAuth 2.0 Client ID (for Google Sign-In)
GOOGLE_CLIENT_ID=

# === Security ===
SECURE_COOKIES=false
ENFORCE_HTTPS=false
CORS_ORIGINS=

# OTP requests allowed per IP per minute
OTP_RATE_LIMIT_MAX=5

# === SMTP (Optional — enables email reminders + OTP emails) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# === Telegram (Optional — enables Telegram reminders) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === AI assistant (Optional — enables ✨ AI rewrite in the editor) ===
# OpenAI-compatible API endpoint (OpenRouter-compatible by default)
AI_API_BASE=https://openrouter.ai/api/v1
# API key — when empty, the AI feature is disabled in the UI
AI_API_KEY=
# Comma-separated allowlist of model ids shown in the model dropdown
AI_MODELS=openai/gpt-6-luna,z-ai/glm-5.3-flash,nvidia/nemotron-3.5-super-vl:free,openai/gpt-5.6-luna
# Model selected by default at the start of each session
AI_DEFAULT_MODEL=nvidia/nemotron-3.5-super-vl:free

# === Version history (auto-save snapshots) ===
# Minimum seconds between two automatic snapshots of a note
VERSION_MIN_INTERVAL_SECS=900
# Maximum snapshots kept per note (older ones are pruned)
VERSION_MAX_KEEP=10
